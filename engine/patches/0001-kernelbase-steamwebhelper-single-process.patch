+/* Bodega hack: Steam's web helper (Chromium) only draws its window on macOS with Wine 11 when
+ * its browser runs in a single process; frames presented from another process never reach the
+ * window (same symptom as Wine bug 56014). Only the top-level process is changed (children carry --type=).
+ * BODEGA_STEAMWEBHELPER_ARGS overrides the switches; an empty value disables the hack. */
+static WCHAR *bodega_steamwebhelper_cmdline( const WCHAR *app_name, const WCHAR *cmd_line )
+{
+    WCHAR args[256], *ret, *start, *end;
+    const WCHAR *base;
+    DWORD len;
+
+    if (!app_name || !cmd_line) return NULL;
+    base = wcsrchr( app_name, '\\' );
+    base = base ? base + 1 : app_name;
+    if (wcsicmp( base, L"steamwebhelper.exe" )) return NULL;
+    if (wcsstr( cmd_line, L"--type=" )) return NULL;
+
+    SetLastError( ERROR_SUCCESS );
+    len = GetEnvironmentVariableW( L"BODEGA_STEAMWEBHELPER_ARGS", args, ARRAY_SIZE(args) );
+    if (!len && GetLastError() == ERROR_ENVVAR_NOT_FOUND) lstrcpyW( args, L"--disable-gpu --single-process" );
+    else if (len >= ARRAY_SIZE(args)) return NULL;
+    if (!args[0]) return NULL;
+
+    if (!(ret = RtlAllocateHeap( GetProcessHeap(), 0, (wcslen( cmd_line ) + wcslen( args ) + 2) * sizeof(WCHAR) )))
+        return NULL;
+    lstrcpyW( ret, cmd_line );
+    for (start = args; *start; start = end)
+    {
+        while (*start == ' ') start++;
+        if (!*start) break;
+        for (end = start; *end && *end != ' '; end++) ;
+        if (*end) *end++ = 0;
+        if (wcsstr( ret, start )) continue;
+        lstrcatW( ret, L" " );
+        lstrcatW( ret, start );
+    }
+    FIXME( "HACK: steamwebhelper command line %s\n", debugstr_w(ret) );
+    return ret;
+}
